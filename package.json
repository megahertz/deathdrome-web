{
  "name": "deathdrome-web",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node utils/serve.ts",
    "start:clean": "node utils/serve.ts --clean",
    "preview": "node utils/serve.ts --dist",
    "test": "node utils/run-tests.ts",
    "test:reference": "node utils/run-tests.ts --reference",
    "build": "npm run typecheck && node utils/build.ts",
    "check:dist": "node utils/check-dist.ts",
    "start:reference": "node utils/serve.ts --private --host 127.0.0.1",
    "test:portable": "node utils/run-tests.ts --portable",
    "typecheck": "tsc --noEmit",
    "lint": "oxfmt --check && oxlint --max-warnings 0",
    "format": "oxfmt && oxlint --fix",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:dist",
    "build:code": "node utils/compile.ts"
  },
  "imports": {
    "#three": "./public/vendor/three.module.js"
  },
  "devDependencies": {
    "@megahertz/oxconfig": "1.0.2",
    "@types/node": "26.6.6",
    "@types/three": "0.170.0",
    "fflate": "0.8.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
